NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_starter
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=auth-kit:rate-limit:v1
RATE_LIMIT_KEY_SECRET=replace-with-an-independent-long-random-secret
# Comma-separated IPs or CIDRs. Forwarded headers are ignored when empty.
RATE_LIMIT_TRUSTED_PROXIES=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_starter

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Auth Kit <noreply@example.com>
