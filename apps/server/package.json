{
  "name": "saas-starter-api",
  "version": "1.0.50",
  "scripts": {
    "test": "NODE_ENV=test bun test --preload ./test/preload.ts --isolate",
    "test:coverage": "NODE_ENV=test bun test --preload ./test/preload.ts --isolate --coverage",
    "test:rate-limit:integration": "NODE_ENV=test RATE_LIMIT_INTEGRATION=true bun test --preload ./test/preload.ts --isolate test/rate-limit.integration.test.ts",
    "dev": "bun run --watch src/index.ts",
    "email": "email dev --dir src/emails",
    "db:generate": "drizzle-kit generate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.3.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.2",
    "@elysiajs/openapi": "^1.4.12",
    "@paralleldrive/cuid2": "^3.0.4",
    "@react-email/components": "^0.5.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.44.5",
    "drizzle-typebox": "^0.3.3",
    "elysia": "1.4.28",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@react-email/preview-server": "4.2.8",
    "@types/nodemailer": "^6.4.17",
    "bun-types": "^1.3.4",
    "drizzle-kit": "^0.31.5",
    "react-email": "^4.2.8"
  },
  "module": "src/index.js"
}
